<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#30FFFFFF">

    <item>
        <layer-list>

            <item>
                <shape>
                    <solid android:color="#24FFFFFF" />
                    <stroke
                        android:width="0.6dp"
                        android:color="#38FFFFFF" />
                    <corners android:radius="14dp" />
                </shape>
            </item>

            <item
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="18dp">
                <shape>
                    <gradient
                        android:angle="270"
                        android:startColor="#30FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="13dp" />
                </shape>
            </item>

        </layer-list>
    </item>

</ripple>