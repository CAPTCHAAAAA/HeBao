<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#18000000">

    <item>
        <layer-list>

            <!-- 卡片主体：不太透明，文字清晰 -->
            <item>
                <shape>
                    <solid android:color="#F3FFFFFF" />
                    <stroke
                        android:width="0.8dp"
                        android:color="#FFFFFFFF" />
                    <corners android:radius="20dp" />
                </shape>
            </item>

            <!-- 上方玻璃反光 -->
            <item
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="26dp">
                <shape>
                    <gradient
                        android:angle="270"
                        android:startColor="#9EFFFFFF"
                        android:centerColor="#38FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="19dp" />
                </shape>
            </item>

            <!-- 左上角柔光 -->
            <item
                android:left="10dp"
                android:top="8dp"
                android:right="150dp"
                android:bottom="34dp">
                <shape>
                    <solid android:color="#5CFFFFFF" />
                    <corners android:radius="999dp" />
                </shape>
            </item>

            <!-- 底部轻微阴影压住层次 -->
            <item
                android:left="1dp"
                android:top="40dp"
                android:right="1dp"
                android:bottom="1dp">
                <shape>
                    <gradient
                        android:angle="90"
                        android:startColor="#08000000"
                        android:endColor="#00000000" />
                    <corners android:radius="19dp" />
                </shape>
            </item>

        </layer-list>
    </item>

</ripple>