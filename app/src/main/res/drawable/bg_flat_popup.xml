<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 黑曜玻璃主体 -->
    <item>
        <shape>
            <solid android:color="#F01E1E1E" />
            <stroke
                android:width="0.8dp"
                android:color="#42FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <!-- 顶部光效反射 -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="52dp">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#46FFFFFF"
                android:centerColor="#18FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>

    <!-- 右上角冷光 -->
    <item
        android:left="54dp"
        android:top="8dp"
        android:right="10dp"
        android:bottom="92dp">
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#1FFFFFFF"
                android:endColor="#55FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>

    <!-- 底部暗部，让文字更稳 -->
    <item
        android:left="1dp"
        android:top="72dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#22000000"
                android:endColor="#00000000" />
            <corners android:radius="21dp" />
        </shape>
    </item>

</layer-list>